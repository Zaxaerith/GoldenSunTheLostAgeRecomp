!/src/patches/*.cpp
!/src/game/
!/src/game/*.cpp
!/src/game/*.h
!/src/generated_bios/
!/src/generated_bios/*.cpp
!/src/generated_bios/*.h
!/tests/
!/tests/*.cpp
!/third_party_licenses/
