# Publish only the reviewed source manifest below. In particular, ROM/BIOS
# dumps, saves, generated code, logs, archives, and local build products stay local.
*
AGENT_PROMPT.md
*.gba
*.sav
*.bin
*.json
*.txt
*.bmp
*.png
*.zip
*.zip.sha256
*.7z
*.tar
*.gz
*.cfg
*.ini
/build/
/build-*/
/reference/
/recomp/
/recomp_cache/
/release-stage/
/logs/
/backup/
/docs/
/.gh-auth/
/release-smoke*/
/.deps/

